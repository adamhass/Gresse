{
  "run_label": "acm-sec-geo-churn",
  "execution_mode": "remote_agents",
  "agent_start_delay_seconds": 45,
  "agent_monitor_interval_seconds": 15,
  "agent_arm_timeout_seconds": 180,
  "agent_completion_grace_seconds": 120,
  "duration_seconds": 1800,
  "bucket": "gresse",
  "s3_region": "eu-north-1",
  "replicas_per_vm": 5,
  "sync_interval_ms": 1000,
  "discovery_interval_ms": 5000,
  "gc_interval_ms": 60000,
  "workload_rate_per_server": 10.0,
  "snapshot_interval_seconds": 30,
  "final_convergence_seconds": 120,
  "startup_timeout_seconds": 10,
  "startup_max_attempts": 3,
  "startup_retry_delay_seconds": 1,
  "process_stop_timeout_seconds": 20,
  "membership_settle_seconds": 30,
  "max_clock_skew_ms": 5000,
  "durable_recovery": true,
  "expected_binary_sha256": "REPLACE_WITH_RELEASE_BINARY_SHA256",
  "ssh_timeout_seconds": 30,
  "launch_timeout_seconds": 180,
  "collection_timeout_seconds": 300,
  "remote_shutdown_grace_seconds": 20,
  "remote_deadline_slack_seconds": 600,
  "ssh_options": [],
  "vms": [
    {"name": "stockholm", "region": "eu-north-1", "ssh_host": "ubuntu@STOCKHOLM_VM", "bind_ip": "0.0.0.0", "advertise_ip": "10.0.0.11", "client_host": "STOCKHOLM_VM", "binary_path": "/opt/gresse/orset_bench_replica"},
    {"name": "frankfurt", "region": "eu-central-1", "ssh_host": "ubuntu@FRANKFURT_VM", "advertise_ip": "10.0.1.11", "client_host": "FRANKFURT_VM", "binary_path": "/opt/gresse/orset_bench_replica"},
    {"name": "ireland", "region": "eu-west-1", "ssh_host": "ubuntu@IRELAND_VM", "advertise_ip": "10.0.2.11", "client_host": "IRELAND_VM", "binary_path": "/opt/gresse/orset_bench_replica"},
    {"name": "london", "region": "eu-west-2", "ssh_host": "ubuntu@LONDON_VM", "advertise_ip": "10.0.3.11", "client_host": "LONDON_VM", "binary_path": "/opt/gresse/orset_bench_replica"},
    {"name": "paris", "region": "eu-west-3", "ssh_host": "ubuntu@PARIS_VM", "advertise_ip": "10.0.4.11", "client_host": "PARIS_VM", "binary_path": "/opt/gresse/orset_bench_replica"}
  ],
  "events": [
    {"at_seconds": 300, "action": "crash", "vm": "stockholm", "slot": 0},
    {"at_seconds": 360, "action": "spawn", "vm": "stockholm", "slot": 0},
    {"at_seconds": 420, "action": "graceful_stop", "vm": "frankfurt", "slot": 1},
    {"at_seconds": 480, "action": "spawn", "vm": "frankfurt", "slot": 1},
    {"at_seconds": 540, "action": "crash", "vm": "ireland", "slot": 2},
    {"at_seconds": 600, "action": "spawn", "vm": "ireland", "slot": 2},
    {"at_seconds": 660, "action": "graceful_stop", "vm": "london", "slot": 3},
    {"at_seconds": 720, "action": "spawn", "vm": "london", "slot": 3},
    {"at_seconds": 780, "action": "crash", "vm": "paris", "slot": 4},
    {"at_seconds": 840, "action": "spawn", "vm": "paris", "slot": 4}
  ]
}
